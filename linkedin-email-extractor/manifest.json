{
  "manifest_version": 3,
  "name": "LinkedIn Email Extractor",
  "version": "1.0.0",
  "description": "Find public contact emails on LinkedIn profiles you are viewing.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["*://*.linkedin.com/*", "https://autocomplete.clearbit.com/*", "https://api.github.com/*", "https://dns.google/*", "https://api.hunter.io/*", "https://api.apollo.io/*"],
  "action": {
    "default_title": "Find email on this profile",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}